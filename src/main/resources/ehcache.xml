<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.ehcache.org/v3"
        xsi:schemaLocation="http://www.ehcache.org/v3 https://www.ehcache.org/schema/ehcache-core.xsd">

    <cache alias="posts">
        <key-type>java.lang.Object</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry><ttl unit="seconds">60</ttl></expiry>
        <heap unit="entries">100</heap>
    </cache>

    <cache alias="topPosts">
        <key-type>java.lang.Object</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry><ttl unit="seconds">30</ttl></expiry>
        <heap unit="entries">100</heap>
    </cache>

    <cache alias="analytics">
        <key-type>java.lang.Object</key-type>
        <value-type>java.lang.Object</value-type>
        <expiry><ttl unit="seconds">60</ttl></expiry>
        <heap unit="entries">10</heap>
    </cache>
</config>
